# Copier en .env à côté de docker-compose.yml et adapter.
POSTGRES_PASSWORD=change-me
FM_ADMIN_PASSWORD=change-me
FM_JWT_SECRET=generate-a-long-random-secret
# Authentification MQTT des AGV (vide = broker ouvert, réservé aux réseaux isolés)
FM_MQTT_USERNAME=agv
FM_MQTT_PASSWORD=change-me
# Origines autorisées pour l'interface web (CORS)
FM_CORS_ORIGINS=http://localhost:3000
# Démarrer N AGV simulés au lancement (0 = désactivé)
FM_SIM_AUTOSTART=0
# URL du backend vue depuis le navigateur
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
